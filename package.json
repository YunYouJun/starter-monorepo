{
  "name": "starter-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "description": "TypeScript Monorepo Starter with VitePress Documentation",
  "author": "YunYouJun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/starter-monorepo.git"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "build": "nr -r build",
    "dev": "nr -r --parallel dev",
    "lint": "eslint --cache .",
    "prepublishOnly": "nr build",
    "predocs": "nr docs:api",
    "docs:api": "typedoc",
    "docs:dev": "nr docs:api && pnpm -C docs run docs:dev",
    "docs:build": "nr build && nr docs:api && pnpm -C docs run docs:build",
    "docs:preview": "pnpm -C docs run docs:preview",
    "release": "bumpp -r && pnpm -r publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:exports": "nr build && node --test test/exports.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "verify:init": "node scripts/verify-init.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@antfu/ni": "catalog:",
    "@antfu/utils": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "lint-staged": "catalog:",
    "pkg-placeholder": "workspace:*",
    "publint": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
